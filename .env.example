# Core
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATA_DIR=./data

# LiteLLM gateway. The application only calls this OpenAI-compatible endpoint.
# Configure this one gateway to route qwen-chat and research-fast to their own
# vLLM backend ports; the harness selects aliases, not backend URLs.
LITELLM_API_BASE=http://127.0.0.1:4000/v1
LITELLM_API_KEY=
LITELLM_MODEL=qwen-chat
LITELLM_FAST_MODEL=research-fast
# Optional profile overrides. Leave blank to use LITELLM_MODEL.
MODEL_BALANCED=
MODEL_REASONING=
MODEL_CRITIC=
MODEL_EXTRACTOR=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
# Bounded structured choice over an already deterministic EDC shortlist.
EDC_CANONICALIZATION_MAX_TOKENS=2048
LLM_OUTPUT_RETRIES=3

# Direct OpenAI-SDK baseline
SIMPLE_RETRIEVAL_PER_DOCUMENT=6
SIMPLE_MAX_PASSAGES=12
SIMPLE_PASSAGE_MAX_CHARS=3000
SIMPLE_LLM_MAX_TOKENS=2048
# Only used when selecting Full or Reasoning model in the Simple app.
SIMPLE_FULL_LLM_MAX_TOKENS=32768
# Reasoning uses a compact, result-first input/output envelope.
SIMPLE_REASONING_RETRIEVAL_PER_DOCUMENT=4
SIMPLE_REASONING_MAX_PASSAGES=4
SIMPLE_REASONING_PASSAGE_MAX_CHARS=1200
SIMPLE_REASONING_LLM_MAX_TOKENS=8000
SIMPLE_REASONING_EFFORT=low
SIMPLE_REQUEST_TIMEOUT_SECONDS=360

# Optional non-secret vLLM/runtime declarations for experiment reproducibility.
LLM_RUNTIME_ID=
LLM_RUNTIME_REVISION=
LLM_CONTEXT_WINDOW=
LLM_CHAT_TEMPLATE=
LLM_REASONING_MODE=
LLM_REASONING_PARSER=
LLM_TOOL_CALL_PARSER=
LLM_RUNTIME_BACKEND=vllm
LLM_RUNTIME_QUANTIZATION=
LLM_RUNTIME_DTYPE=
LLM_RUNTIME_TENSOR_PARALLEL_SIZE=

# Provider keys are consumed by LiteLLM, not handed to research agents or shell tools.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=
OPENROUTER_API_KEY=

# Agentic harness budgets
MAX_AGENT_STEPS=28
MAX_SUBAGENT_CALLS=18
MAX_RUN_SECONDS=900
MAX_EVIDENCE_SPANS=24
MAX_EVIDENCE_CHARS=45000
MAX_TOOL_OUTPUT_CHARS=20000
CONTEXT_WARN_FRACTION=0.82
CONTEXT_CLEAR_FRACTION=0.70
ENABLE_CONTEXT_MANAGEMENT=true
CONTEXT_COMPACT_TARGET_FRACTION=0.30
CONTEXT_SAFETY_MARGIN_TOKENS=2048
CONTEXT_SUMMARY_MAX_TOKENS=1024
# Optional distinct model for typed working-memory summaries. Blank uses the Director model.
CONTEXT_SUMMARY_MODEL=
CONTEXT_TOOL_RESULT_MAX_CHARS=8000
CONTEXT_CLAMP_PART_CHARS=12000
CONTEXT_KEEP_TOOL_PAIRS=4

# Harness capabilities
ENABLE_AGENT_SHELL=true
ENABLE_AGENT_BASH=false
ENABLE_DYNAMIC_WORKFLOW=true
ENABLE_CODE_MODE=true
ENABLE_STEP_PERSISTENCE=true
AGENT_SHELL_TIMEOUT_SECONDS=20
AGENT_TOOL_EXTENSIONS=

# Retrieval: deliberately no embeddings/vector DB
LEXICAL_TOP_K=14
CONTEXT_EXPANSION_PARAGRAPHS=2
RETRIEVAL_ALLOW_SHELL_SEARCH=true
RETRIEVAL_ALLOW_GRAPH_SEARCH=true
PDF_MAX_PAGES=300

# Optional parser adapters. Empty means PyMuPDF local fallback.
GROBID_URL=
DOCLING_URL=

# Ontology / validation
ALLOW_ONTOLOGY_EXTENSIONS=true
SHACL_STRICT=false
EDC_UPSTREAM_PATH=
ENABLE_EMBEDDING_CANONICALIZATION_ABLATION=false

# Optional durable execution: none | dbos | prefect | temporal
DURABILITY_BACKEND=none
DATABASE_URL=sqlite:///./data/research.db

# Observability. Never put real keys in source control.
ENABLE_LOGFIRE=false
LOGFIRE_TOKEN=
ENABLE_LANGTRACE=true
LANGTRACE_API_KEY=
LANGTRACE_API_HOST=https://your-langtrace-host.example/api/trace
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=thesis-research-harness
ENABLE_LLM_EVAL=false

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8100
BACKEND_INTERNAL_URL=http://127.0.0.1:8100
